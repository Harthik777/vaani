# ==============================================================================
# VAANI BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to `.env` in the `backend/` directory to configure credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SARVAM AI: speech-to-text (Saaras), text-to-speech (Bulbul), Translate
# The key turns all three on. Field names follow https://docs.sarvam.ai/api-reference.
# ------------------------------------------------------------------------------
USE_REAL_SARVAM=true
SARVAM_API_KEY=
# Models checked against docs.sarvam.ai on 2026-10-17.
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix          # v4 only. codemix keeps English words in Latin script inside Hindi/Kannada text
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=              # blank = one persona per language (services/sarvam.py V4_SPEAKERS); for bulbul:v3 use shubh
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1

# Sarvam's own chat model (OpenAI-compatible, /v1). The interview agent (gap questions, conflict check)
# runs on it first and falls back to the main LLM; a circuit breaker stops waiting on it after 2 failures.
# Empty answers in earlier tests were reasoning tokens eating max_tokens: the request now uses the
# short-turn "conversations" model, reasoning_effort=low, max_tokens 3000 and strict JSON schemas.
#   LLM_PROVIDER=sarvam   -> use it as the main brain as well (no second key needed)
#   AGENT_LLM=main        -> never use it for the agent
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_LLM_MAX_TOKENS=3000
SARVAM_LLM_TIMEOUT=8                 # the gap check answers in ~5 s on the 105B; past 8 s the fast Gemini model takes over
AGENT_LLM=sarvam

# Response cache (LLM drafts, Bulbul audio, translations) under backend/data/cache. A rehearsal makes the
# identical stage run instant. VAANI_CACHE=off disables it.
VAANI_CACHE=on

# ------------------------------------------------------------------------------
# 2. MAIN LLM (reasoning: gap questions, extraction, conflicts, BRD drafting, app generation)
# The provider is detected from the key:
#   - Google Gemini:   key starting with 'AIzaSy' or 'AQ.' (default model gemini-3.5-flash)
#   - Groq:            key starting with 'gsk_'
#   - OpenRouter:      key starting with 'sk-or-'
#   - Anthropic:       key starting with 'sk-ant-'
#   - OpenAI:          any other key
# Or set LLM_URL and LLM_MODEL for any OpenAI-compatible endpoint.
# ------------------------------------------------------------------------------
USE_REAL_LLM=true
LLM_API_KEY=
# LLM_MODEL=gemini-3.8-flash
# LLM_URL=https://api.openai.com/v1/chat/completions

# Speed (measured 17 Oct with real input). Short structured tasks (gap check fallback, extraction + conflicts in one call)
# use the fast model; long writing (BRD draft, app) uses LLM_MODEL with thinking set to low.
LLM_FAST_MODEL=gemini-3.5-flash-lite
LLM_THINKING=low
LLM_TIMEOUT=45
# Parallel Sarvam Translate requests on one connection. 10 is safe; 40 hit Sarvam's 429 rate limit.
TRANSLATE_CONCURRENCY=10

# ------------------------------------------------------------------------------
# 3. PAYMENTS & TICKET WEBHOOKS (Optional)
# Standard UPI deep-linking (upi://pay) works out of the box with zero keys.
# ------------------------------------------------------------------------------
USE_REAL_PAYTM=false
PAYTM_MID=
PAYTM_KEY=
PAYTM_ENV=staging

# Email the BRD pack (PDF + Word + Excel) from the BRD page. Gmail: create an app password. Optional.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional external work order webhook
WORK_ORDER_URL=
WORK_ORDER_API_KEY=

# Share links and QR codes must open on a phone. The backend serves the built frontend (npx vite build) at
# http://<laptop LAN address>:8000/app/ for phones on the same Wi-Fi (run uvicorn with --host 0.0.0.0). For a link that
# works from anywhere, run `cloudflared tunnel --url http://localhost:8000` (free, no account) and put the https address here:
PUBLIC_URL=

# Google Drive (the BRD lands in the owner's Drive as a Google Doc) and Google Calendar (inferred deadlines as events).
# Free: Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application), redirect URI
# http://localhost:8000/api/google/callback; enable the Drive API and the Calendar API. Without these, VAANI still offers
# an .ics download and one-click "Add to Google Calendar" links, and emails the pack to the address given at the start.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=http://localhost:8000/api/google/callback
