# ==============================================================================
# VAANI BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to `.env` in the `backend/` directory to configure credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SARVAM AI: speech-to-text (Saaras), text-to-speech (Bulbul), Translate
# The key turns all three on. Field names follow https://docs.sarvam.ai/api-reference.
# ------------------------------------------------------------------------------
USE_REAL_SARVAM=true
SARVAM_API_KEY=
# Models checked against docs.sarvam.ai on 2026-10-17.
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix          # v4 only. codemix keeps English words in Latin script inside Hindi/Kannada text
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=              # blank = one persona per language (services/sarvam.py V4_SPEAKERS); for bulbul:v3 use shubh
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1

# Sarvam's own chat model (OpenAI-compatible, /v1). Opt-in for the interview agent (gap questions, conflict check):
#   AGENT_LLM=sarvam      -> try it first, fall back to the main LLM (circuit breaker after 2 failures)
#   AGENT_LLM=main        -> default: the fast Gemini model. On 17 Oct the chat endpoint returned 403 for a key that
#                            STT, TTS and Translate accepted, so every agent call paid a failure plus a slow fallback.
#   LLM_PROVIDER=sarvam   -> use it as the main brain as well (no second key needed)
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_LLM_MAX_TOKENS=3000
SARVAM_LLM_TIMEOUT=30
AGENT_LLM=main

# Response cache (LLM drafts, Bulbul audio, translations) under backend/data/cache. A rehearsal makes the
# identical stage run instant. VAANI_CACHE=off disables it.
VAANI_CACHE=on

# ------------------------------------------------------------------------------
# 2. MAIN LLM (reasoning: gap questions, extraction, conflicts, BRD drafting, app generation)
# The provider is detected from the key:
#   - Google Gemini:   key starting with 'AIzaSy' or 'AQ.' (default model gemini-3.5-flash)
#   - Groq:            key starting with 'gsk_'
#   - OpenRouter:      key starting with 'sk-or-'
#   - Anthropic:       key starting with 'sk-ant-'
#   - OpenAI:          any other key
# Or set LLM_URL and LLM_MODEL for any OpenAI-compatible endpoint.
# ------------------------------------------------------------------------------
USE_REAL_LLM=true
LLM_API_KEY=
# LLM_MODEL=gemini-3.6-flash
# LLM_URL=https://api.openai.com/v1/chat/completions

# Speed (measured 17 Oct with real input). Short structured tasks (gap check, extraction + conflicts) use the fast model;
# long writing (BRD draft, app) uses LLM_MODEL with thinking set to low (13 s -> 5 s on extraction, same result).
LLM_FAST_MODEL=gemini-3.5-flash-lite
LLM_THINKING=low
LLM_TIMEOUT=45
# Parallel Sarvam Translate requests on one connection. 10 is safe; 40 hit Sarvam's 429 rate limit.
TRANSLATE_CONCURRENCY=10

# ------------------------------------------------------------------------------
# 3. PAYMENTS & TICKET WEBHOOKS (Optional)
# Standard UPI deep-linking (upi://pay) works out of the box with zero keys.
# ------------------------------------------------------------------------------
USE_REAL_PAYTM=false
PAYTM_MID=
PAYTM_KEY=
PAYTM_ENV=staging

# Optional external work order webhook
WORK_ORDER_URL=
WORK_ORDER_API_KEY=
